{
  "name": "safety-vr",
  "version": "0.1.0",
  "private": true,
  "description": "SAFETY VR — capacitación en seguridad industrial con realidad virtual (ULTRAMEDIA COMPANY). MVP: motor de escenarios, visor 360° WebXR, telemetría xAPI y certificados encadenados.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test \"src/*/*.test.ts\"",
    "romper": "node tools/romper-motor.mjs",
    "previsualizacion": "node --experimental-strip-types tools/construir-previsualizacion.mjs",
    "probar-visor": "node tools/probar-visor.mjs",
    "verificar": "npm test && npm run romper && npm run previsualizacion",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
